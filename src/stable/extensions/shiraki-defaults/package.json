{
  "name": "shiraki-defaults",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.0.0",
  "publisher": "vscode",
  "license": "MIT",
  "engines": {
    "vscode": "*"
  },
  "categories": [
    "Other"
  ],
  "contributes": {
    "configurationDefaults": {
      "extensions.ignoreRecommendations": true,
      "workbench.startupEditor": "none",
      "editor.minimap.enabled": false,
      "chat.agentsControl.enabled": "hidden",
      "breadcrumbs.enabled": false,
      "git.autofetch": false,
      "npm.autoDetect": "off",
      "files.watcherExclude": {
        "**/node_modules/**": true,
        "**/vendor/**": true,
        "**/wp-content/uploads/**": true,
        "**/wp-content/cache/**": true,
        "**/dist/**": true,
        "**/build/**": true,
        "**/.next/**": true
      },
      "search.exclude": {
        "**/node_modules": true,
        "**/vendor": true,
        "**/wp-content/uploads": true,
        "**/wp-content/cache": true,
        "**/dist": true,
        "**/build": true,
        "**/.next": true
      }
    },
    "walkthroughs": [
      {
        "id": "shiraki.claudeCode",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "shiraki.claudeCode.install",
            "title": "%walkthrough.install.title%",
            "description": "%walkthrough.install.description%",
            "media": {
              "image": "media/shiraki.svg",
              "altText": "%walkthrough.media.altText%"
            },
            "completionEvents": [
              "extensionInstalled:anthropic.claude-code"
            ]
          },
          {
            "id": "shiraki.claudeCode.open",
            "title": "%walkthrough.open.title%",
            "description": "%walkthrough.open.description%",
            "media": {
              "image": "media/shiraki.svg",
              "altText": "%walkthrough.media.altText%"
            },
            "completionEvents": [
              "onCommand:claude-vscode.editor.open"
            ]
          }
        ]
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/moriyama-dev/shiraki.git"
  }
}
