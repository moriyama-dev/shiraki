+class OpenGitHubUrlAction extends Action2 {
+
+	static readonly ID = 'workbench.action.openGitHubUrl';
+	// Shiraki: the repository, next to "Report Issue", read from product.json "githubUrl"
+	static readonly URL = (product as { githubUrl?: string }).githubUrl;
+	static readonly AVAILABLE = !isWeb && !!OpenGitHubUrlAction.URL;
+
+	constructor() {
+		super({
+			id: OpenGitHubUrlAction.ID,
+			title: {
+				...localize2('openGitHubUrl', "GitHub"),
+				mnemonicTitle: localize({ key: 'miGitHub', comment: ['&& denotes a mnemonic'] }, "&&GitHub"),
+			},
+			category: Categories.Help,
+			f1: true,
+			menu: {
+				id: MenuId.MenubarHelpMenu,
+				group: '3_feedback',
+				order: 2
+			}
+		});
+	}
+
+	run(accessor: ServicesAccessor): void {
+		if (OpenGitHubUrlAction.URL) {
+			accessor.get(IOpenerService).open(URI.parse(OpenGitHubUrlAction.URL));
+		}
+	}
+}
